# GitHub Personal Access Token (read-only, public repos)
# Used by netlify/functions/getPinnedRepos.js
# Create a token at: https://github.com/settings/tokens
# Set this as an environment variable in Netlify dashboard:
# Site settings → Environment variables → GITHUB_TOKEN
GITHUB_TOKEN=ghp_your_token_here

# Telegram bot credentials for contact form
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
